# Deployment Configuration
# Options: "vercel" or "self"
# 
# vercel: Deploy ke Vercel, data include di git repository
# self: Self-hosted Docker, data download saat runtime
#
DEPLOY_TYPE=vercel

# Jika DEPLOY_TYPE=self, tentukan source download data
# (Default: GitHub raw URL)
DATA_SOURCE_URL=https://raw.githubusercontent.com/Aepra/map-data-pipeline/main/data/peta_murid.parquet

# Optional: Local file path untuk development
# DATA_LOCAL_PATH=./public/data/peta_murid.parquet
