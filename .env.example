# Deployment Configuration
# Use .env.local for real secrets; this file is only an example.

# Microsoft SQL Server / Azure SQL connection
# Option A: single connection string
# MICROSOFT_SQL_CONNECTION_STRING=Server=YOUR_SERVER;Database=YOUR_DATABASE;User Id=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=true;TrustServerCertificate=false;

# Option B: individual values
# MICROSOFT_SQL_SERVER=your-server.database.windows.net
# MICROSOFT_SQL_PORT=1433
# MICROSOFT_SQL_DATABASE=your_database
# MICROSOFT_SQL_USER=your_user
# MICROSOFT_SQL_PASSWORD=your_password
# MICROSOFT_SQL_ENCRYPT=true
# MICROSOFT_SQL_TRUST_SERVER_CERTIFICATE=false

# Query used to generate public/data/peta_murid.parquet
# Make sure the query returns the columns used by Geospatial:
# lintang, bujur, jenjang, nama_sekolah_tujuan, status_penerimaan,
# status_verifikasi, kecamatan, desa, lintang_sekolah, bujur_sekolah,
# jarak, id_peserta, jalur
# MICROSOFT_SQL_QUERY=SELECT ...
